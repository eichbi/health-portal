# Base de datos Postgres. Vercel la inyecta sola al conectar Vercel Postgres/Neon;
# en local apunta a tu instancia (el fallback DATABASE_URL también funciona).
POSTGRES_URL=postgresql://usuario:password@localhost:5432/fittrack

# Contraseña única de acceso al portal (R9). Sin ella el portal queda cerrado.
ACCESS_PASSWORD=cambia-esto
